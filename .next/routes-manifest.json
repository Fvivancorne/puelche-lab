    {
      "source": "/fotografia-y-edicion-2/",
      "destination": "/servicios/fotografia",
      "statusCode": 308,
      "regex": "^(?!/_next)/fotografia-y-edicion-2/(?:/)?$"
    },
    {
      "source": "/edicion-fotografica",
      "destination": "/servicios/fotografia",
      "statusCode": 308,
