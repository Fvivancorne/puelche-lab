{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/diseno-de-marca",
      "destination": "/servicios/branding",
      "statusCode": 308,
      "regex": "^(?!/_next)/diseno-de-marca(?:/)?$"
    },
    {
      "source": "/diseno-de-marca/",
      "destination": "/servicios/branding",
      "statusCode": 308,
      "regex": "^(?!/_next)/diseno-de-marca/(?:/)?$"
    },
    {
      "source": "/fotografia-y-edicion-2",
