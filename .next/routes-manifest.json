    },
    {
      "source": "/edicion-fotografica/",
      "destination": "/servicios/fotografia",
      "statusCode": 308,
      "regex": "^(?!/_next)/edicion-fotografica/(?:/)?$"
    },
    {
      "source": "/diseno-editorial",
      "destination": "/servicios/editorial",
      "statusCode": 308,
      "regex": "^(?!/_next)/diseno-editorial(?:/)?$"
    },
    {
      "source": "/diseno-editorial/",
      "destination": "/servicios/editorial",
      "statusCode": 308,
      "regex": "^(?!/_next)/diseno-editorial/(?:/)?$"
    },
    {
      "source": "/redes-sociales",
      "destination": "/servicios/branding",
      "statusCode": 308,
      "regex": "^(?!/_next)/redes-sociales(?:/)?$"
    },
    {
      "source": "/redes-sociales/",
      "destination": "/servicios/branding",
      "statusCode": 308,
      "regex": "^(?!/_next)/redes-sociales/(?:/)?$"
    },
    {
      "source": "/nuestros-clientes",
